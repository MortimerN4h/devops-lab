<!-- Notes.csproj = the .NET project file (MSBuild XML): framework version, settings and NuGet packages.
     Equivalent of package.json / pom.xml / go.mod. "dotnet build" / "dotnet publish" read it. -->
<Project Sdk="Microsoft.NET.Sdk.Web"> <!-- ".Web" SDK = ASP.NET Core (web server Kestrel, routing, JSON) included -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework> <!-- .NET 10 = current LTS (long-term support) -->
    <Nullable>enable</Nullable>                <!-- the compiler warns when a value could be null -->
    <ImplicitUsings>enable</ImplicitUsings>    <!-- common "using System..." lines are added automatically -->
    <!-- No culture data (ICU) needed: dates/numbers always formatted the same way. Lets us use the small Alpine image. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet = the package registry of .NET (like npm for Node, Maven Central for Java).
         Added with: dotnet add package AWSSDK.DynamoDBv2  (it writes this line with the newest version) -->
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.1.0.3" />
  </ItemGroup>

</Project>
