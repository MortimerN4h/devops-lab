<?xml version="1.0" encoding="UTF-8"?>
<!-- pom.xml = "Project Object Model": Maven reads this file to know the project's name, Java version,
     libraries (dependencies) and how to build it. Equivalent of package.json / go.mod / requirements.txt. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Parent = Spring Boot's ready-made settings: compatible versions of ~hundreds of libraries,
       so the dependencies below need NO version numbers. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.0</version>
    <relativePath/>
  </parent>

  <!-- This project's own coordinates (groupId:artifactId:version) -->
  <groupId>lab</groupId>
  <artifactId>notes</artifactId>
  <version>1.0.0</version>

  <properties>
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <!-- "Starters" = one dependency that pulls a whole tested set of libraries -->
    <dependency> <!-- REST API: Spring MVC + embedded Tomcat web server + Jackson (JSON) -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency> <!-- Database: JPA (Hibernate) + connection pool (HikariCP) -->
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency> <!-- The MySQL driver: only needed when the app RUNS, not to compile it -->
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName> <!-- output: target/app.jar (instead of notes-1.0.0.jar) -->
    <plugins>
      <!-- Packs the code + ALL libraries into ONE runnable "fat jar": java -jar app.jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
