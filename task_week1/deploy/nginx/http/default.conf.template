# MODE http: used BEFORE the certificate exists (NGINX_MODE=http in .env).
# ${DOMAIN} is replaced at container start; nginx's own $variables are left untouched.

# Docker's internal DNS (127.0.0.11) is asked again every 10 s, so a container that was RECREATED
# (new IP) is found. Without this, nginx resolves names only once at start and keeps the old IP -> 502.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 80 default_server; # also answers requests by IP (http://<Elastic IP>)
    server_name node.${DOMAIN};

    # Let's Encrypt "HTTP-01 challenge": certbot writes a token file here, Let's Encrypt fetches
    # http://node.<domain>/.well-known/acme-challenge/<token> to prove we control the domain.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        set $upstream http://node-frontend; # container name on the "node" network, port 80
        proxy_pass $upstream; # a variable = resolve at request time (with the resolver above)
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

