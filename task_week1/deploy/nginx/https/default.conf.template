# MODE https: used AFTER certbot created /etc/letsencrypt/live/<app>.<domain>/ for EVERY app below (NGINX_MODE=https).

# Docker's internal DNS (127.0.0.11) is asked again every 10 s, so a container that was RECREATED
# (new IP) is found. Without this, nginx resolves names only once at start and keeps the old IP -> 502.
resolver 127.0.0.11 valid=10s ipv6=off;

# Access log = the default "combined" columns (so $9 is still the status) + which app (host) + how long (seconds).
# Used by ../../logs.sh. access_log is set in EVERY server block: one at http level would ADD a second log
# next to the image's default one (each request written twice), a server-level one REPLACES it.
log_format edge '$remote_addr - $remote_user [$time_local] "$request" $status $body_bytes_sent '
                '"$http_referer" "$http_user_agent" host=$host rt=$request_time';

# Port 80: keep serving the challenge (needed for renewals), send everything else to HTTPS.
server {
    access_log /var/log/nginx/access.log edge; # stdout of the container (docker logs edge)
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri; # 301 = moved permanently
    }
}

server {
    access_log /var/log/nginx/access.log edge; # stdout of the container (docker logs edge)
    listen 443 ssl;
    http2 on;
    server_name node.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/node.${DOMAIN}/fullchain.pem; # cert + intermediate CA
    ssl_certificate_key /etc/letsencrypt/live/node.${DOMAIN}/privkey.pem;   # private key (never share)
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        set $upstream http://node-frontend;
        proxy_pass $upstream; # a variable = resolve at request time (with the resolver above)
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

