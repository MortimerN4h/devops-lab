# MODE https: used AFTER certbot created /etc/letsencrypt/live/node.<domain>/ (NGINX_MODE=https).

# Port 80: keep serving the challenge (needed for renewals), send everything else to HTTPS.
server {
    listen 80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri; # 301 = moved permanently
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name node.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/node.${DOMAIN}/fullchain.pem; # cert + intermediate CA
    ssl_certificate_key /etc/letsencrypt/live/node.${DOMAIN}/privkey.pem;   # private key (never share)
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://node-frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
